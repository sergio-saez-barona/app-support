{
  "name": "ssaezba/appsupport",
  "require": {
    "php": ">=8.2",
    "psr/log": "^3.0",
    "ext-mbstring": "*",
    "php-collective/toml": "^0.1.5"
  },
  "require-dev": {
    "php": ">=8.4",
    "phpunit/phpunit": "^13.4"
  },
  "autoload": {
    "files": [
      "src/Support/helpers.php"
    ],
    "psr-4": {
      "AppSupport\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "AppSupport\\Tests\\": "tests"
    }
  },
  "bin": [
    "bin/php-bump-version"
  ],
  "scripts": {
    "test": "phpunit"
  },
  "version": "1.0.0",
  "minimum-stability": "dev",
  "prefer-stable": true
}
